# Copy this file to .env for Docker Compose. In Portainer use stack variables.
# Bind to your server's PRIVATE LAN IPv4 address to enable home-network access.
# Loopback is deliberately the safe default.
TUBELOADER_BIND_IP=127.0.0.1
# Address entered in the browser, without http:// or a port:
TUBELOADER_SERVER_HOST=localhost
TUBELOADER_PORT=8765
# Limits apply to each video; byte limit is per downloaded stream.
TUBELOADER_MAX_DURATION=7200
TUBELOADER_MAX_DOWNLOAD_MB=2048
TUBELOADER_MIN_FREE_MB=1024
# Portainer only: your PUBLIC clone URL, optionally with #main.
# Never put a password/token in this value.
TUBELOADER_GIT_URL=

